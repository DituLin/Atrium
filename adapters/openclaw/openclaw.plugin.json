      "optional": true
    },
    "home_show_photo": {
      "optional": true
    },
    "home_refresh_screen": {
      "optional": true
    },
    "home_list_family_members": {
      "optional": true
    },
    "home_list_family_records": {
      "optional": true
    },
    "home_record_family_entry": {
      "optional": true
