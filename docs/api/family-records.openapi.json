                              },
                              "notes": {
                                "type": "string",
                                "maxLength": 16000
                              },
                              "measurements": {
                                "type": "array",
                                "maxItems": 32,
                                "items": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "metric",
