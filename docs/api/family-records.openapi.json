                                    "unit"
                                  ],
                                  "properties": {
                                    "metric": {
                                      "type": "string",
                                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
                                    },
                                    "value": {
                                      "type": "number"
                                    },
                                    "unit": {
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 32
                                    }
                                  }
                                }
                              },
                              "display_on_tv": {
                                "type": "boolean",
                                "default": false
                              },
                              "id": {
                                "type": "string"
                              },
                              "created_at": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "exported_at": {
                                "type": "string",
