      "hostBinary",
      "hostArgs",
      "toolsFile"
    ],
    "properties": {
      "agentId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "hostBinary": {
        "type": "string",
        "minLength": 1
      },
      "hostArgs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 32
      },
      "toolsFile": {
        "type": "string",
        "minLength": 1
      }
    }
  }
